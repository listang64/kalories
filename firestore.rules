rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isCouple() {
      return request.auth != null
        && request.auth.uid in ['Ai6mNQSmQ9M4kSixvyrZORNhbxF2', 'PDR3pus71PSnyTnsaJ1CRc2BAXs2'];
    }
    match /users/{uid} {
      allow read, write: if isCouple();
    }
    match /meals/{mealId} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && request.resource.data.uid in ['Ai6mNQSmQ9M4kSixvyrZORNhbxF2', 'PDR3pus71PSnyTnsaJ1CRc2BAXs2']
        && request.resource.data.items is list;
    }
    match /shopping/{itemId} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;
    }
  }
}
